{
    "compilerOptions": {
        "module": "commonjs",
        "target": "es6",
        "noImplicitAny": false,
        "sourceMap": true,
        "rootDir": "..",
        "noEmitOnError": true,
        "esModuleInterop": true,
        "typeRoots": ["../node_modules/@types","../src/@custom_types"],
        "types": ["jquery"],
        "skipLibCheck": true,
    },
    "exclude": [
        "node_modules",
    ]
}